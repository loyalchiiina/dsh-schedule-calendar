{
  "name": "dsh-schedule-calendar",
  "version": "1.0.0",
  "description": "侧边栏日程中心（dsh-better-sidebar companion）：今日一屏（多城市天气按 8:30/12:00/17:30 定点刷新 + 黄历 + 可折叠星座运势）、农历月历、日程与待办、日报周报与签到、按人设置班制与上下班倒计时；多账号邮件客户端（IMAP 收信 + SMTP 发信，附件收发、群发、草稿箱、收藏/垃圾/垃圾箱/已读未读）；久坐 / 喝水 / 护眼 / 听音乐提醒弹面板内胶囊（停留秒数与位置可调）并可同时推 Windows 通知；壁纸轮播（顺序或随机洗牌、透明度与磨砂）与界面文字颜色可调。数据只存本机。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "data/defaults.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "scripts/toast.ps1",
    "locale/*.json",
    "docs/screenshots/**",
    "screenshots.json"
  ],
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "dsh-better-sidebar",
    "calendar",
    "schedule",
    "todo",
    "weather",
    "almanac",
    "horoscope",
    "email",
    "mail",
    "imap",
    "smtp",
    "attachments",
    "reminders",
    "toast",
    "wallpaper",
    "appearance"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "manifestVersion": 1,
    "capabilities": [
      "network:egress",
      "network:ingress",
      "subprocess"
    ],
    "labels": [
      "remote-access"
    ]
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-0 <0.3.0"
  },
  "dependencies": {
    "solarlunar": "3.1.0",
    "imapflow": "^2.11.0",
    "mailparser": "^3.14.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loyalchiiina/dsh-schedule-calendar.git"
  },
  "homepage": "https://github.com/loyalchiiina/dsh-schedule-calendar#readme",
  "bugs": {
    "url": "https://github.com/loyalchiiina/dsh-schedule-calendar/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-0 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "author": {
    "name": "loyalchiiina",
    "url": "https://github.com/loyalchiiina"
  }
}
