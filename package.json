{
  "name": "dsh-schedule-calendar",
  "version": "0.4.2",
  "description": "日程中心（dsh-better-sidebar companion）：侧边栏日程表——多城市天气、节假日、日程与提醒、工作待办、按人设置休息日（双休/大小周/单休/自定义）与上下班倒计时提醒。存储数据随插件包走，便于打包。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "data/defaults.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "scripts/toast.ps1",
    "locale/*.json",
    "docs/screenshots/**",
    "screenshots.json"
  ],
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "dsh-better-sidebar",
    "calendar",
    "schedule",
    "weather",
    "todo"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "manifestVersion": 1,
    "capabilities": [
      "network:egress",
      "network:ingress",
      "subprocess"
    ],
    "labels": [
      "remote-access"
    ]
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-0 <0.3.0"
  },
  "dependencies": {
    "solarlunar": "3.1.0",
    "imapflow": "^2.11.0",
    "mailparser": "^3.14.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loyalchiiina/dsh-schedule-calendar.git"
  },
  "homepage": "https://github.com/loyalchiiina/dsh-schedule-calendar#readme",
  "bugs": {
    "url": "https://github.com/loyalchiiina/dsh-schedule-calendar/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-0 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
